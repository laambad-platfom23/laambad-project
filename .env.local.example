# Next.js full-stack env (copy to .env.local)

NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres (Dashboard → Connection string → URI)
# Use the pooled connection for serverless / Next.js when available.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# JWT
JWT_SECRET=development-only-replace-with-openssl-rand-base64-48
JWT_REFRESH_SECRET=
JWT_ISSUER=sodemy
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
