/// Streak: one row per user per learning day (Africa/Mogadishu calendar day).
model LearningDay {
  userId        String   @map("user_id") @db.Uuid
  day           DateTime @db.Date
  activityCount Int      @default(1) @map("activity_count")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("learning_days")
}

/// Group discussion: one room per course.
model CourseDiscussionMessage {
  id        String    @id @db.Uuid
  courseId  String    @map("course_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  body      String    @db.Text
  /// A3: optional image (uploaded through the class room)
  imageUrl  String?   @map("image_url") @db.VarChar(1024)
  isPinned  Boolean   @default(false) @map("is_pinned")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  course  Course                    @relation(fields: [courseId], references: [id])
  user    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  CourseDiscussionMessage?  @relation("DiscussionReplies", fields: [parentId], references: [id])
  replies CourseDiscussionMessage[] @relation("DiscussionReplies")

  @@index([courseId, createdAt(sort: Desc)], map: "course_discussion_course_created_idx")
  @@map("course_discussion_messages")
}

