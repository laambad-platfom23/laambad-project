  legacyId   BigInt   @map("legacy_id")
  entityUuid String   @map("entity_uuid") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@id([entityType, legacyId])
  @@index([entityUuid])
