  coverUrl    String?   @map("cover_url") @db.VarChar(1024)
  fileUrl     String?   @map("file_url") @db.VarChar(1024)
  fileName    String?   @map("file_name") @db.VarChar(255)
  fileSize    BigInt?   @map("file_size")
  isFree      Boolean   @default(true) @map("is_free")
  price       Decimal   @default(0) @db.Decimal(16, 2)
  currency    String    @default("USD") @db.VarChar(8)
  status      String    @default("draft") @db.VarChar(16)
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()

