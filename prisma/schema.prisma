}

model MigrationException {
  id         String   @id @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  entityType String   @map("entity_type") @db.VarChar(64)
  // 0 means "no single source id". NOT NULL so the unique key below dedupes on rerun
  // (PostgreSQL treats NULLs as distinct in a unique index).
  legacyId   BigInt   @default(0) @map("legacy_id")
  code       String   @db.VarChar(64)
  detail     String?  @db.VarChar(255)

  @@unique([code, entityType, legacyId])
  @@index([code, entityType])
  @@map("migration_exceptions")
}

/// A1: one-time e-mail codes (password reset / verify e-mail). Only an HMAC of the code is stored.
model EmailCode {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  purpose    String    @db.VarChar(32)
  codeHash   String    @map("code_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz()
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz()
  ip         String?   @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt(sort: Desc)], map: "email_codes_user_purpose_created_idx")
  @@map("email_codes")
}

